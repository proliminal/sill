<Project Sdk="Microsoft.NET.Sdk">

  <!-- What plugins reference. No WPF or Windows Forms on purpose: plugins describe their pages, Sill draws them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Proliminal.Sill.Sdk</RootNamespace>
    <AssemblyName>Proliminal.Sill.Sdk</AssemblyName>
    <!-- Plugin authors only see the SDK through IntelliSense, so every public member is documented. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Only the SDK is open source; Sill itself isn't. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Raise the minor with each release that adds to the SDK: Sill doesn't load a plugin built against a newer SDK
         than its own, which would fail on what's missing. A major change breaks every plugin, and isn't planned. -->
    <Version>1.1.0</Version>
  </PropertyGroup>

  <!-- Sill builds the page models plugins describe; plugins only get the builders. -->
  <ItemGroup>
    <InternalsVisibleTo Include="sill" />
  </ItemGroup>

</Project>
